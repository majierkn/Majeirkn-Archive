# ============================================================
# Configuração do Bot de Música Discord
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA versione o arquivo .env com segredos reais!
# ============================================================

# ---- Obrigatório ----
DISCORD_TOKEN=seu_token_aqui
APPLICATION_ID=seu_application_id_aqui

# ---- Opcional ----
# ID do canal de texto para logs de erro (ex: canal privado de admins)
LOG_CHANNEL_ID=

# Ambiente: development (mais logs) ou production
ENVIRONMENT=production

# Caminho do banco de dados SQLite
DB_PATH=data/bot.db

# ---- Configurações padrão ----
DEFAULT_VOLUME=100
MAX_QUEUE_SIZE=200
MAX_PLAYLISTS_PER_USER=20
MAX_TRACKS_PER_PLAYLIST=500
PLAY_COOLDOWN_SECONDS=3
INACTIVITY_TIMEOUT_MINUTES=5

# ---- Integrações opcionais ----
# Last.fm (para /scrobble)
LASTFM_API_KEY=
LASTFM_API_SECRET=

# SponsorBlock (skip de patrocinadores automático)
SPONSORBLOCK_ENABLED=true
